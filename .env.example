# Envío del formulario (https://resend.com). Obligatoria.
RTC_RESEND_API_KEY=
# Remitente verificado en Resend (dominio resuelvetucontrato.com con SPF/DKIM).
RTC_RESEND_FROM_EMAIL="Web Resuelve Tu Contrato <web@resuelvetucontrato.com>"
# Casilla que recibe los leads.
RTC_LEADS_DESTINO=contacto@resuelvetucontrato.com,marcos@resuelvetucontrato.com

# Bloqueo de envíos repetidos (24 h). Se crean solas al conectar Upstash Redis
# desde Vercel > Storage (plan gratuito). Sin ellas, el bloqueo funciona en memoria.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Pixel de Meta (ya configurado por defecto).
NEXT_PUBLIC_META_PIXEL_ID=763916406253405
# API de Conversiones de Meta (opcional, recomendado). Se genera en Events Manager.
META_CAPI_TOKEN=
# Solo para probar eventos en Events Manager > Probar eventos. Borrar en producción.
META_TEST_EVENT_CODE=
